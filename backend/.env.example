# Copy to backend/.env for local development (all settings are optional).

# SQLAlchemy URL. Default: SQLite file backend/qa_allocation.db
# DATABASE_URL=postgresql+psycopg://qa_alloc:qa_alloc@localhost:5432/qa_alloc

# Comma-separated origins allowed to call the API from a browser (dev server by default).
# CORS_ORIGINS=http://localhost:5173

# IANA timezone that defines "today" for allocation status. Default: server local time.
# TIMEZONE=Europe/Kyiv

# Serve the built frontend from the API process.
# FRONTEND_DIST=../frontend/dist
